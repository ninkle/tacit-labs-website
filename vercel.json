{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/benchmark-builder-gdm",
      "destination": "/benchmark-builder-gdm/",
      "permanent": false
    },
    {
      "source": "/benchmark-builder-nvidia",
      "destination": "/benchmark-builder-nvidia/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/catalogue",
      "destination": "https://data-portal-theta.vercel.app/catalogue"
    },
    {
      "source": "/catalogue/:path*",
      "destination": "https://data-portal-theta.vercel.app/catalogue/:path*"
    },
    {
      "source": "/apply",
      "destination": "https://applications-portal-lake.vercel.app/apply"
    },
    {
      "source": "/apply/:path*",
      "destination": "https://applications-portal-lake.vercel.app/apply/:path*"
    }
  ]
}
